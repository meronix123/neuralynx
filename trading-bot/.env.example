# Kopiere diese Datei zu ".env" und trage deine Schluessel ein.
# Die .env wird NIE hochgeladen (steht in .gitignore).
#
# Bitget-API-Schluessel anlegen: Bitget -> Profil -> API-Verwaltung
#   - Rechte: NUR "Futures handeln" (Lesen + Trade)
#   - KEIN Auszahlungsrecht!
#   - IP-Beschraenkung auf deine eigene IP, wenn moeglich
#
# Fuer den Demo-Modus brauchst du eigene Demo-API-Schluessel
# (Bitget -> Demo-Handel -> API-Verwaltung).

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# Optional: Telegram-Benachrichtigungen
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
